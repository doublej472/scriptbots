#version 450
layout(local_size_x = 48) in;

shared float val[48];

layout(set = 0, binding = 0, std430) readonly buffer BufW { float w[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufI { float inp[]; };
layout(set = 0, binding = 2, std430) buffer       BufO { float output_vals[]; };

layout(push_constant) uniform PC {
    uint agent_count;
    uint group_count_x;
} pc;

void main() {
    uint agent = gl_WorkGroupID.x + gl_WorkGroupID.y * pc.group_count_x;
    if (agent >= pc.agent_count) return;
    uint lane  = gl_LocalInvocationID.x;

    uint in_off = agent * 48;
    val[lane] = inp[in_off + lane];
    barrier();

    uint base = agent * 7056;
    for (uint l = 0; l < 3; l++) {
        uint loff = base + l * 2352;

        float sum = 0.0;
        for (uint j = 0; j < 48; j++)
            sum += val[j] * w[loff + j * 48 + lane];

        sum += w[loff + 2304 + lane];
        val[lane] = clamp(sum, 0.0, 1.0);
        barrier();
    }

    output_vals[in_off + lane] = val[lane];
}
