#version 450
#include "brain_config.h"

layout(local_size_x = NEURONS_PER_LAYER) in;

shared float val[NEURONS_PER_LAYER];

layout(set = 0, binding = 0, std430) readonly buffer BufW { float w[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufI { float inp[]; };
layout(set = 0, binding = 2, std430) buffer       BufO { float output_vals[]; };

layout(push_constant) uniform PC {
    uint agent_count;
    uint group_count_x;
} pc;

void main() {
    uint agent = gl_WorkGroupID.x + gl_WorkGroupID.y * pc.group_count_x;
    if (agent >= pc.agent_count) return;
    uint lane  = gl_LocalInvocationID.x;

    uint in_off = agent * NEURONS_PER_LAYER;
    val[lane] = inp[in_off + lane];
    barrier();

    uint base = agent * BRAIN_WEIGHT_FLOATS;
    for (uint l = 0; l < BRAIN_LAYERS; l++) {
        uint loff = base + l * FLOATS_PER_LAYER;

        float sum = 0.0;
        for (uint j = 0; j < NEURONS_PER_LAYER; j++)
            sum += val[j] * w[loff + j * NEURONS_PER_LAYER + lane];

        sum += w[loff + WEIGHTS_PER_LAYER + lane];
        val[lane] = clamp(sum, 0.0, 1.0);
        barrier();
    }

    output_vals[in_off + lane] = val[lane];
}
